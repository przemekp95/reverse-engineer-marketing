# All keys are optional. Without any key, REM still scans the website, tracking
# stack (incl. GTM containers), SEO/sitemaps, Wayback positioning history,
# App Store, and Hacker News — and gives you manual-check links for the rest.

# Unlocks ad libraries (Meta, LinkedIn), TikTok/IG/YouTube/X/
# LinkedIn/Threads stats, founder discovery and Reddit mentions.
# ~25–50 credits per full run. https://scrapecreators.com
SCRAPECREATORS_API_KEY=

# Unlocks the written strategy report (`rem <url>` without --no-llm).
# Not needed when you use REM through MCP — your agent writes the report.
ANTHROPIC_API_KEY=

# Official Google Ads Transparency data (EEA/Turkey), independent of ScrapeCreators.
# Configure Application Default Credentials separately; do not paste tokens here.
# Save domain-specific advertiser IDs with `rem google-link <domain> AR…` or use
# `--google-advertiser AR…`. Estimate first: `rem google-estimate AR…`.
REM_BIGQUERY_PROJECT_ID=
# Default 1 GiB is a hard per-query cap, usually below this unpartitioned table's
# scan size. It is never raised automatically. See docs/google-bigquery.md.
# REM_BIGQUERY_MAX_BYTES_BILLED=1073741824

# Optional overrides
# REM_MODEL=claude-opus-5
# REM_MAX_CREDITS=50
# REM_USER_AGENT=
